APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=43200

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Алерты об упавшей очереди/failed_jobs (App\Service\Ops\TelegramAlert,
# queue:monitor-health) — намеренно НЕ через email, см. комментарий в
# TelegramAlert.php. Отдельный бот/чат от захардкоженного в LeadController.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Claude API — ИИ-черновик проверки письменных заданий (config/anthropic.php)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_EFFORT=high
ANTHROPIC_TIMEOUT=180
# Из РФ API напрямую недоступен: http://user:pass@host:port
ANTHROPIC_PROXY=
ANTHROPIC_BASE_URL=
# true / false / путь к cacert.pem (локально на Windows: cURL error 60)
ANTHROPIC_VERIFY=true
ANTHROPIC_ENABLED=true

# Бот воронки пробного урока @poltavskiy_ege_bot (config/services.php,
# telegram_funnel; настройка — deploy/README.md, раздел 8)
TELEGRAM_FUNNEL_BOT_TOKEN=
# id супергруппы с темами для диалогов (узнать: написать /chatid в группе)
TELEGRAM_FUNNEL_ADMIN_CHAT_ID=
# любая длинная случайная строка: openssl rand -hex 32
TELEGRAM_FUNNEL_WEBHOOK_SECRET=

# Бот диагностики (config/services.php, telegram_diag). Админ-группа — та же,
# TELEGRAM_FUNNEL_ADMIN_CHAT_ID; бота нужно добавить туда админом с правом
# управлять темами. Webhook: php artisan telegram:webhook diag
TELEGRAM_DIAG_BOT_TOKEN=
TELEGRAM_DIAG_WEBHOOK_SECRET=

# Ключи моих сайтов для заявок в бот (config/inbound_leads.php)
INBOUND_LEAD_KEY_EGE_TEACHER=
