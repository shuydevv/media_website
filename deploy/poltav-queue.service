[Unit]
Description=Poltavskiy Media - Laravel queue worker
After=network.target mysql.service

[Service]
# www-data, не deploy: php-fpm тоже работает как www-data (см. pool.d/*.conf),
# и оба процесса пишут в один и тот же storage/framework/cache/data —
# Laravel создаёт подпапки там с правами 0755 (Filesystem::makeDirectory()),
# setgid на storage/framework передаёт группу новым подпапкам, но НЕ право
# записи для группы. Пока воркер был deploy, а не www-data, он не мог писать
# в cache-подпапки, которые первым создал php-fpm (deploy состоит в группе
# www-data, но у группы там нет w-бита, только r-x) — и наоборот. На практике
# это ловилось как "Permission denied" при попытке воркера записать статус
# доставки письма с кодом входа (App\Providers\AppServiceProvider — Cache::put
# для /auth/email/status), из-за чего JS-поллер на странице входа ждал
# несуществующий статус бесконечно. Один и тот же пользователь для обоих
# процессов убирает саму возможность такого конфликта.
User=www-data
Group=www-data
Restart=always
RestartSec=3

# /var/www/poltav/current — симлинк на актуальный релиз, а не жёстко забитый
# путь: если так же захардкодить конкретный releases/<timestamp>, воркер
# переживёт сколько угодно деплоев на старом коде, а когда деплой рано или
# поздно удалит эту папку при уборке старых релизов (RELEASES_TO_KEEP) —
# начнёт падать на каждом require случайно ещё не подгруженного класса.
# Именно так однажды тихо легла вся отправка писем.
WorkingDirectory=/var/www/poltav/current
ExecStart=/usr/bin/php /var/www/poltav/current/artisan queue:work --queue=default --sleep=3 --tries=3 --timeout=120 --max-time=3600

# --max-time=3600 — воркер сам выходит раз в час, systemd (Restart=always)
# тут же поднимает новый процесс заново резолвя симлинк current/artisan.
# Дополнительная страховка на случай, если сигнал `artisan queue:restart`
# после деплоя почему-то не долетит (кэш-based, зависит от storage/framework/
# cache) — раз в час воркер и так пересоберётся на актуальном релизе.

StandardOutput=append:/var/www/poltav/shared/storage/logs/queue-worker.log
StandardError=append:/var/www/poltav/shared/storage/logs/queue-worker.log

[Install]
WantedBy=multi-user.target
